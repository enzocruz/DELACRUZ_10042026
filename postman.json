{
    "info": {
        "name": "File Processing API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5099"
        }
    ],
    "item": [
        {
            "name": "Upload file",
            "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/files/upload",
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "file",
                            "type": "file",
                            "src": ""
                        }
                    ]
                }
            }
        },
        {
            "name": "Get report",
            "request": {
                "method": "GET",
                "url": "{{baseUrl}}/api/reports"
            }
        }
    ]
}